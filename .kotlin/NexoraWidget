package com.example.nexora

import android.app.PendingIntent
import android.appwidget.AppWidgetManager
import android.appwidget.AppWidgetProvider
import android.content.Context
import android.content.Intent
import android.widget.RemoteViews
import org.json.JSONArray

class NexoraWidget : AppWidgetProvider() {

    override fun onUpdate(
        context: Context,
        appWidgetManager: AppWidgetManager,
        appWidgetIds: IntArray
    ) {

        for (appWidgetId in appWidgetIds) {

            updateWidget(
                context,
                appWidgetManager,
                appWidgetId
            )
        }
    }

    companion object {

        fun updateWidget(
            context: Context,
            appWidgetManager: AppWidgetManager,
            appWidgetId: Int
        ) {

            val views =
                RemoteViews(
                    context.packageName,
                    R.layout.widget_nexora
                )

            val prefs =
                context.getSharedPreferences(
                    "nexora_notes",
                    Context.MODE_PRIVATE
                )

            val notesJson =
                prefs.getString(
                    "notes",
                    null
                )

            var lessonCount =
                0

            if (
                !notesJson.isNullOrBlank()
            ) {

                try {

                    val array =
                        JSONArray(
                            notesJson
                        )

                    lessonCount =
                        array.length()

                } catch (
                    ignored: Exception
                ) {
                }
            }

            views.setTextViewText(
                R.id.widget_lesson_count,
                "$lessonCount Lessons"
            )

            /* ================================================
               OPEN NEXORA
               ================================================= */

            val openIntent =
                Intent(
                    context,
                    MainActivity::class.java
                )

            val openPendingIntent =
                PendingIntent.getActivity(

                    context,

                    100,

                    openIntent,

                    PendingIntent.FLAG_UPDATE_CURRENT or
                            PendingIntent.FLAG_IMMUTABLE
                )

            views.setOnClickPendingIntent(
                R.id.widget_root,
                openPendingIntent
            )

            /* ================================================
               NEW LESSON
               ================================================= */

            val newNoteIntent =
                Intent(
                    context,
                    MainActivity::class.java
                ).apply {

                    putExtra(
                        "OPEN_NEW_NOTE",
                        true
                    )
                }

            val newNotePendingIntent =
                PendingIntent.getActivity(

                    context,

                    101,

                    newNoteIntent,

                    PendingIntent.FLAG_UPDATE_CURRENT or
                            PendingIntent.FLAG_IMMUTABLE
                )

            views.setOnClickPendingIntent(
                R.id.widget_new_note,
                newNotePendingIntent
            )

            /* ================================================
               FAVORITES
               ================================================= */

            val favoriteIntent =
                Intent(
                    context,
                    MainActivity::class.java
                ).apply {

                    putExtra(
                        "OPEN_FAVORITES",
                        true
                    )
                }

            val favoritePendingIntent =
                PendingIntent.getActivity(

                    context,

                    102,

                    favoriteIntent,

                    PendingIntent.FLAG_UPDATE_CURRENT or
                            PendingIntent.FLAG_IMMUTABLE
                )

            views.setOnClickPendingIntent(
                R.id.widget_favorites,
                favoritePendingIntent
            )

            appWidgetManager.updateAppWidget(
                appWidgetId,
                views
            )
        }
    }
}